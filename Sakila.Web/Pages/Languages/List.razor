@page "/languages"
@using Sakila.Contracts.Languages.Commands
@using Sakila.Contracts.Languages.Queries.Responses
@using Sakila.Web.Pages.BaseCrud

<BaseCrudPage
    TService="ILanguageService"
    TCreate="LanguageCreateRequest"
    TUpdate="LanguageUpdateRequest"
    TGetAll="LanguageGetAllResponse"
    TGetById="LanguageGetByIdResponse"
    TItem="LanguageGetByIdResponse"
    TCreateDialog="LanguageCreateDialog"
    TUpdateDialog="LanguageUpdateDialog"
    TDeleteDialog="ConfirmDelete"
    Title="Languages"
    AddButtonText="Add Language"
    CreateDialogTitle="Add Language"
    UpdateDialogTitle="Edit Language"
    DeleteDialogTitle="Delete Language"
    ItemsSelector="@(r => r.Languages)"
    HeaderContent="@<MudTh>Name</MudTh>"
    RowTemplate="@(context => @<MudTd DataLabel=\"Name\">@context.Name</MudTd>)"
    UpdateDialogParameters="@(lang => new DialogParameters { [nameof(LanguageUpdateDialog.Language)] = lang })"
    DeleteDialogParameters="@(lang => new DialogParameters { [nameof(ConfirmDelete.Language)] = lang })" />
