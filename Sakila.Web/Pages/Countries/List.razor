@page "/countries"
@using Sakila.Contracts.Countries.Commands
@using Sakila.Contracts.Countries.Queries.Responses
@using Sakila.Web.Pages.BaseCrud

<BaseCrudPage
    TService="ICountryService"
    TCreate="CountryCreateRequest"
    TUpdate="CountryUpdateRequest"
    TGetAll="CountryGetAllResponse"
    TGetById="CountryGetByIdResponse"
    TItem="CountryGetByIdResponse"
    TCreateDialog="CountryCreateDialog"
    TUpdateDialog="CountryUpdateDialog"
    TDeleteDialog="ConfirmDelete"
    Title="Countries"
    AddButtonText="Add Country"
    CreateDialogTitle="Add Country"
    UpdateDialogTitle="Edit Country"
    DeleteDialogTitle="Delete Country"
    ItemsSelector="@(r => r.Countries)"
    HeaderContent="@<MudTh>Name</MudTh>"
    RowTemplate="@(context => @<MudTd DataLabel=\"Name\">@context.Name</MudTd>)"
    UpdateDialogParameters="@(c => new DialogParameters { [nameof(CountryUpdateDialog.Country)] = c })"
    DeleteDialogParameters="@(c => new DialogParameters { [nameof(ConfirmDelete.Country)] = c })" />
