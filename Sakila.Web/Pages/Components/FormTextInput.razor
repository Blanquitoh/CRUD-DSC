<div class="mb-3">
    <input class="form-control @(HasErrors ? "is-invalid" : "")" @bind="Value" placeholder="@Label" @oninput="OnInput"/>
    @if (HasErrors)
    {
        <div class="invalid-feedback d-block ps-3">
            @foreach (var error in FieldErrors)
            {
                <div>@error</div>
            }
        </div>
    }
</div>