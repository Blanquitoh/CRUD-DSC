@typeparam TService
@typeparam TCreate
@typeparam TUpdate
@typeparam TGetAll
@typeparam TGetById
@typeparam TItem
@typeparam TCreateDialog
@typeparam TUpdateDialog
@typeparam TDeleteDialog
@inherits BaseCrudPageBase<TService, TCreate, TUpdate, TGetAll, TGetById, TItem, TCreateDialog, TUpdateDialog, TDeleteDialog>

<MudGrid Class="mb-3 pt-3">
    <MudItem xs="6">
        <MudText Typo="Typo.h3" Class="my-0">@Title</MudText>
    </MudItem>
    <MudItem xs="6" Align="End" Class="d-flex justify-end">
        <MudButton Size="Size.Small" Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="ShowCreateDialog">
            @AddButtonText
        </MudButton>
    </MudItem>
</MudGrid>

<CrudTable Items="Items">
    <HeaderContent>
        @HeaderContent
        <MudTh Align="Right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        @RowTemplate(item)
        <MudTd Align="Right">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Warning"
                           Size="Size.Small"
                           OnClick="@(() => ShowUpdateDialog(item))"
                           Class="me-1" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="@(() => ShowDeleteDialog(item))" />
        </MudTd>
    </RowTemplate>
</CrudTable>
